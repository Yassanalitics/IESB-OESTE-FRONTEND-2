generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                 Int @id @default(1)
  workTime           Int
  shortBreakMinutes  Int
  longBreakMinutes   Int
  updatedAt          DateTime @updatedAt
}

model Task {
  id          String      @id 
  name        String
  duration    Int
  type        String
  
  completeDate  BigInt? 
  interruptDate BigInt?  

  createdAt   DateTime @default(now())
}